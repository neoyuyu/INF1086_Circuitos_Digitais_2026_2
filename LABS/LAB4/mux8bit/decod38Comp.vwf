<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="/home/gabriel/Documentos/2026-2/CD/LAB4/mux8bit/simulation/qsim/" mux8bit -c mux8bit</tnetlist_cmd>
