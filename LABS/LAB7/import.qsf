# Lab 8 - Contador up/down - DE0 (Cyclone III EP3C16F484C6)
# Gabriel Tafarel / Sayid Safa

# ---------- Dispositivo ----------
set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE EP3C16F484C6
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

# ---------- Top-level (ajuste para o nome do seu .bdf) ----------
# set_global_assignment -name TOP_LEVEL_ENTITY lab8_top

# ---------- Clock e reset ----------
set_location_assignment PIN_G21 -to clk
set_location_assignment PIN_H2  -to rst

# ---------- Dado d[7..0] = SW0 a SW7 ----------
set_location_assignment PIN_J6 -to d[0]
set_location_assignment PIN_H5 -to d[1]
set_location_assignment PIN_H6 -to d[2]
set_location_assignment PIN_G4 -to d[3]
set_location_assignment PIN_G5 -to d[4]
set_location_assignment PIN_J7 -to d[5]
set_location_assignment PIN_H7 -to d[6]
set_location_assignment PIN_E3 -to d[7]

# ---------- Seletor sel[1..0] = SW8 e SW9 ----------
set_location_assignment PIN_E4 -to sel[0]
set_location_assignment PIN_D2 -to sel[1]

# ---------- HEX1 (digito alto, q[7..4]) ----------
set_location_assignment PIN_A13 -to a1
set_location_assignment PIN_B13 -to b1
set_location_assignment PIN_C13 -to c1
set_location_assignment PIN_A14 -to d1_hex
set_location_assignment PIN_B14 -to e1
set_location_assignment PIN_E14 -to f1
set_location_assignment PIN_A15 -to g1

# ---------- HEX0 (digito baixo, q[3..0]) ----------
set_location_assignment PIN_E11 -to a2
set_location_assignment PIN_F11 -to b2
set_location_assignment PIN_H12 -to c2
set_location_assignment PIN_H13 -to d2_hex
set_location_assignment PIN_G12 -to e2
set_location_assignment PIN_F12 -to f2
set_location_assignment PIN_F13 -to g2

# ---------- Padrao de I/O ----------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst